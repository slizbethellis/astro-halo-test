---
import { Picture } from "astro:assets";
import { Masonry } from "astro-masonry";

const { images } = Astro.props;
const slicedImages = images.slice(1);
---

<button
  class="mb-[5px]"
  data-pswp-src={images[0].img.src}
  data-pswp-width={images[0].img.width}
  data-pswp-height={images[0].img.height}
>
  <div class="max-w-[465px]">
    <Picture
      src={images[0].img}
      alt={images[0].alt}
      width={465}
      layout="constrained"
      loading="eager"
    />
  </div>
</button>
{slicedImages.length >= 1 && 
  <Masonry
    breakpointCols={{ default: 4 }}
    sortByHeight={true}
    class="astro-masonry-grid justify-between gap-x-[5px]"
  >
  {slicedImages.map((image: any) => (
    <button
      class="-mt-0.5"
      data-pswp-src={image.img.src}
      data-pswp-width={image.img.width}
      data-pswp-height={image.img.height}
    >
      <div class="max-w-full inline-block">
        <Picture
          src={image.img}
          alt={image.alt}
          width={116}
          layout="constrained"
        />
      </div>
    </button>
  ))}
  </Masonry>
}